{
  "compilerOptions": {
    "lib": ["es2022"],
    "target": "es2022",
    "module": "nodenext",
    "moduleDetection": "force",

    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  // `mise run check` runs the build beside `lint:tsc`, and the build rewrites `dist` as tsc
  // reads it.
  "exclude": ["dist"]
}
