{
  "name": "jappend",
  "version": "1.2.0",
  "description": "Efficiently append entries to JSON array files without loading the entire file into memory.",
  "keywords": [
    "JSON",
    "file",
    "stream"
  ],
  "license": "MIT",
  "author": "Kirill Karpov",
  "repository": {
    "type": "git",
    "url": "https://github.com/karpov-kir/jappend.git"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "type": "module",
  "main": "dist/jappend.js",
  "types": "dist/jappend.d.ts",
  "scripts": {
    "benchmark": "bun ./benchmark.ts all",
    "build": "bun run clean && bun run build.ts",
    "clean": "rimraf dist && rimraf tsconfig.types.tsbuildinfo",
    "lint": "bun run lint:oxlint && bun run lint:format && bun run lint:tsc",
    "lint:fix": "bun run lint:oxlint:fix && bun run lint:format:fix",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:format": "oxfmt --check",
    "lint:format:fix": "oxfmt",
    "lint:tsc": "tsc --noEmit",
    "release": "./release/release.sh",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:integration": "vitest run --config ./vitest.integ.config.ts",
    "test:unit": "vitest run --config ./vitest.unit.config.ts",
    "test:watch": "bun run test:unit --watch"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "@types/bun": "^1.2.17",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.93.0",
    "rimraf": "^6.0.1",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^3.1.0",
    "vitest-sonar-reporter": "^2.0.1"
  }
}
